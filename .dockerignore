.git/
node_modules/
.next/
dist/
build/

# Environment - never bake secrets into image layers
.env
.env.local
.env.*.local

# License key directory - private key must never enter the build context.
keys/
!keys/README.md

# Claude Code local config and memory
.claude/
memory/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# TypeScript
tsconfig.tsbuildinfo
next-env.d.ts

# User-uploaded documents (runtime data, not source)
data/documents/

# Prisma generated client (regenerated during build)
src/generated/

# Docs not needed inside the image
README.md
CHANGELOG.md
CONTRIBUTING.md
SECURITY.md
CODE_OF_CONDUCT.md
LICENSE
.github/
.gitea/
