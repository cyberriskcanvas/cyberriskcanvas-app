# ─── Database ────────────────────────────────────────────────────────────────
# In docker-compose the host is the service name `db`.
# For local development use `localhost`.
POSTGRES_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql://cyberrisk:${POSTGRES_PASSWORD}@db:5432/cyberrisk

# ─── Redis ───────────────────────────────────────────────────────────────────
# Service name `redis` in docker-compose, `localhost` for local dev.
REDIS_URL=redis://redis:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=same-as-AUTH_SECRET
# Public URL of the app (used for callbacks and CORS).
AUTH_URL=https://your-domain.com
AUTH_TRUST_HOST=true
APP_URL=https://your-domain.com

# ─── External Identity Providers (SSO, Pro feature) ───────────────────────────
# Optional. Leave unset to disable. Users are auto-provisioned on first sign-in
# (matched by e-mail); team membership must still be assigned by an admin.
#
# Generic OIDC - works with Keycloak, Okta, Auth0, or any standards-compliant IdP.
# Register the redirect URI ${AUTH_URL}/api/auth/callback/oidc with your IdP.
# OIDC_ISSUER=https://keycloak.example.com/realms/your-realm
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Keycloak
#
# Microsoft Entra ID (Azure AD).
# Register the redirect URI ${AUTH_URL}/api/auth/callback/microsoft-entra-id with your app registration.
# ENTRA_ID_CLIENT_ID=
# ENTRA_ID_CLIENT_SECRET=
# ENTRA_ID_TENANT_ID=

# ─── First Admin User (auto-created on first start if not exists) ─────────────
ADMIN_EMAIL=admin@your-company.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME=Admin

# ─── License ─────────────────────────────────────────────────────────────────
# The license key is managed via the admin UI (/admin → License).
# This controls how often the key is re-validated against the license server.
# LICENSE_CACHE_DAYS=1

# ─── File Storage ────────────────────────────────────────────────────────────
# Absolute path where uploaded project PDFs are stored.
# In docker-compose this maps to the `documents_data` named volume.
# Default in production: /data/documents  |  Default in dev: ./data/documents
# DOCUMENTS_DIR=/data/documents

# ─── AI (Anthropic Claude) ───────────────────────────────────────────────────
# Optional. If unset, AI-powered suggestions are disabled (Pro feature).
ANTHROPIC_API_KEY=sk-ant-...

# ─── Public URLs (baked in at build time) ────────────────────────────────────
NEXT_PUBLIC_LICENSE_URL=https://cyberriskcanvas.com/
NEXT_PUBLIC_GITHUB_URL=https://github.com/cyberriskcanvas/cyberriskcanvas-app

# ─── CVE Monitoring (periodic re-scan) ───────────────────────────────────────
# Optional. Shared secret for the internal vulnerability re-scan endpoint
# (POST /api/internal/cve-scan with header `Authorization: Bearer <secret>`),
# which refreshes CVE findings for all uploaded SBOMs against OSV.dev.
# Generate with: openssl rand -base64 32
#
# To run it on a schedule, enable the bundled `cve-scan` Compose service - a
# small sidecar in the internal Docker network that calls this endpoint
# periodically (default: every 6 hours, override via CVE_SCAN_INTERVAL_SECONDS):
#   docker compose --profile cve-scan up -d
# Alternatively, point any scheduler that can reach the app (system crontab,
# CI schedule, …) at the endpoint yourself. Leave CVE_SCAN_SECRET unset to
# disable the endpoint entirely.
# CVE_SCAN_SECRET=
# CVE_SCAN_INTERVAL_SECONDS=21600

# ─── Deployment ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1
