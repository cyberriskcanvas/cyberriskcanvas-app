generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Teams ────────────────────────────────────────────────────────────────────

model Team {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("product") // "product" | "review"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       TeamMember[]
  projects      Project[]
  threatLibrary TeamThreatLibraryEntry[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // "lead" | "member"
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @default("")
  role         String   @default("user") // "user" | "admin"
  color        String   @default("#6366F1")
  companyName  String?
  companyLogo  String?  // base64 data-URL, max ~200 KB
  // CSAF publisher profile
  csafPublisherName      String?
  csafPublisherNamespace String?
  csafPublisherCategory  String  @default("vendor") // vendor | coordinator | discoverer | other
  csafIssuingAuthority   String?
  csafContactDetails     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects      Project[]
  versions      DiagramVersion[]
  feedbackItems FeedbackItem[]
  feedbackVotes FeedbackVote[]
  memberships   TeamMember[]
  apiKeys       ApiKey[]

  @@map("users")
}

// ─── License ──────────────────────────────────────────────────────────────────

model License {
  id              String    @id @default(cuid())
  key             String    @unique
  valid           Boolean   @default(false)
  maxUsers        Int       @default(0)
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("licenses")
}

// ─── Projects & Diagrams ─────────────────────────────────────────────────────

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  notes              String?
  notesUpdatedByName String?
  notesUpdatedAt     DateTime?
  // No longer read since 2.0 (one view for everyone); kept so the migration does not drop data.
  taraMode           String    @default("expert")
  // Also assess against IEC 62443: Security Level, IEC part, IEC tab per component, IEC page in the PDF.
  iec62443           Boolean   @default(false)
  // Release gate threshold: untriaged vulnerabilities and SAST/vulnerability-scan/DAST findings from this severity on
  // block (critical | high | medium | low). Secrets block on any finding. A pipeline can override it with failOn.
  gateFailOn         String    @default("high")
  // CRA product data for the roadmap: class (default | class-i | class-ii | critical, Annex III/IV),
  // intended purpose (Annex II 4, Annex VII 1a), support period (Art. 13(8), Annex II 7, Annex VII 4)
  craClass               String?
  intendedPurpose        String?
  supportPeriodEnd       DateTime?
  supportPeriodRationale String?
  // which end-of-support reminders were sent ("90", "30", "7", "0" = days before); reset when the end date changes
  supportReminders       Json      @default("{}")
  // Project-level CRA checklist: requirement id -> { status, note }; takes precedence over node mappings in the SoA
  craChecklist           Json      @default("{}")
  // Architecture check findings dismissed with a reason: finding id -> reason
  modelCheckDismissed    Json      @default("{}")
  // CRA readiness self-assessment, product-scoped answers: question id -> yes | partly | no | unknown
  readiness              Json      @default("{}")
  // Manufacturer, instructions, applied standards and Annex VII entries for the generated documents (src/lib/docData.ts)
  docData                Json      @default("{}")
  // BSI TR-03185 SDL checklist: requirement id -> completed
  sdlChecklist       Json      @default("{}")
  thumbnail   String?
  teamId      String?
  team        Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Diagram stays on project (canvas always reflects current active state)
  diagrams         Diagram[]
  documents        ProjectDocument[]
  measureEvidence  MeasureEvidence[]

  // Explicit versioning - replaces parentId / branches / lockedAt
  versions ProjectVersion[]

  // CI/CD: pipeline tokens and uploaded scan results
  ciTokens CiToken[]

  // Reviews of frozen versions by assessors (review team)
  assessments Assessment[]

  // CRA Art. 14 reporting cases (actively exploited vulnerabilities, severe incidents)
  craIncidents CraIncident[]
  ownVulnerabilities OwnVulnerability[]

  // Triage decisions per component and vulnerability; they survive SBOM re-uploads and new versions
  analyses Analysis[]

  // CSAF is global across all versions
  csafDraft      CsafDraft?
  csafAdvisories CsafAdvisory[]

  // Threat library - project-scoped reusable threat catalogue
  threatLibrary  ThreatLibraryEntry[]

  @@index([teamId])
  @@index([ownerId])
  @@map("projects")
}

// ─── Threat Library ───────────────────────────────────────────────────────────

model ThreatLibraryEntry {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  stride            String   // 'S' | 'T' | 'R' | 'I' | 'D' | 'E'
  cweId             String?
  description       String?
  componentTypeHint String?  // optional tag for filtering, e.g. 'plc', 'gateway', 'ecu'
  createdAt         DateTime @default(now())

  @@index([projectId])
  @@map("threat_library_entries")
}

// ─── Project Versions ─────────────────────────────────────────────────────────
// Each project always has exactly one "active" version (the current work-in-progress).
// Freezing sets the active version to "frozen" and creates a new active v(n+1).
// TARA state at freeze time is captured in DiagramVersion snapshots.
// SBOM + Vulnerabilities are scoped per version.

model ProjectVersion {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number       Int                                  // 1, 2, 3 …
  label        String    @default("")               // user-facing name, e.g. "CRA Audit Q1 2025"
  status       String    @default("active")         // "active" | "frozen"
  frozenAt     DateTime?
  frozenByName String?
  createdAt    DateTime  @default(now())

  sboms           ProjectSbom[]
  vulnerabilities ProjectVulnerability[]
  ciRuns          CiRun[]
  assessment      Assessment?
  metrics         MetricSnapshot[]

  @@unique([projectId, number])
  @@index([projectId])
  @@map("project_versions")
}

model Diagram {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  nodes     Json     @default("[]")
  edges     Json     @default("[]")
  viewport  Json     @default("{\"x\":0,\"y\":0,\"zoom\":1}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions        DiagramVersion[]
  sbomComponents  SbomComponent[]
  measureEvidence MeasureEvidence[]

  @@index([projectId])
  @@map("diagrams")
}

model DiagramVersion {
  id        String   @id @default(cuid())
  diagramId String
  diagram   Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  nodes     Json
  edges     Json
  viewport  Json
  message   String?
  createdAt DateTime @default(now())

  @@index([diagramId])
  @@map("diagram_versions")
}

// ─── Project Documents ────────────────────────────────────────────────────────

model ProjectDocument {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  storagePath String
  size        Int
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@map("project_documents")
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique  // SHA-256 of the full key (hex)
  prefix     String             // first 8 chars after "crc_" for display
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

// Security-relevant actions (user management, license changes, deletions, …).
// Deliberately no FK to users: entries must survive deletion of the actor,
// so actor identity is stored as a snapshot.
model AuditLogEntry {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?  // null for system events (e.g. bootstrap)
  actorEmail String?
  action     String   // e.g. "user.create", "license.save", "document.delete"
  targetType String?  // e.g. "user", "project", "document"
  targetId   String?
  details    Json?    // small, non-sensitive context (names, counts - never secrets)

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_log")
}

// ─── Version-Scoped Operations (SBOM / Vulnerabilities) ──────────────────────

model ProjectSbom {
  id             String         @id @default(cuid())
  versionId      String
  version        ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  // Denormalized for fast project-level access checks
  projectId      String
  fileName       String
  // CI pipelines of multi-part products (frontend/backend/image) upload one SBOM per part
  part           String         @default("")
  format         String         // "CycloneDX" | "SPDX"
  componentCount Int            @default(0)
  uploadedAt     DateTime       @default(now())

  vulnerabilities ProjectVulnerability[]
  components      ProjectSbomComponent[]

  @@index([versionId, part])
  @@index([projectId])
  @@map("project_sboms")
}

// Persisted component list per SBOM upload - needed so the periodic CVE
// re-scan can re-query OSV for components that currently have zero known
// vulnerabilities (the upload flow only ever persisted the resulting vulns).
model ProjectSbomComponent {
  id        String      @id @default(cuid())
  sbomId    String
  sbom      ProjectSbom @relation(fields: [sbomId], references: [id], onDelete: Cascade)
  // Denormalized for the re-scan job (avoids joining through to active versions)
  versionId String
  projectId String
  name      String
  version   String?
  purl      String?
  // Identity of the component across SBOMs and products: purl, else name@version (see componentKey in sbomParse.ts)
  key       String
  type      String?
  cpe       String?
  supplier  String?
  // SPDX license ids or expressions as stated in the SBOM
  licenses  String[]
  hashes    Json?
  // Direct dependency of the product; null when the SBOM has no dependency graph
  direct    Boolean?
  createdAt DateTime    @default(now())

  @@index([sbomId])
  @@index([versionId])
  @@index([key])
  @@map("project_sbom_components")
}

model ProjectVulnerability {
  id               String         @id @default(cuid())
  sbomId           String
  sbom             ProjectSbom    @relation(fields: [sbomId], references: [id], onDelete: Cascade)
  versionId        String
  version          ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  // Denormalized for fast project-level access checks and CSAF aggregation
  projectId        String
  osvId            String
  cveId            String?
  summary          String?
  severity         String?        // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  cvssScore        Float?
  // CVSS v3.x vector from the OSV advisory, exported as CSAF scores/metrics
  cvssVector       String?
  // Listed as actively exploited (CISA KEV) while still unresolved: starts an Art. 14 case
  exploited        Boolean        @default(false)
  exploitedAt      DateTime?
  componentName    String
  componentVersion String?
  componentPurl    String?
  status           String         @default("open") // "open" | "in_triage" | "affected" | "not_affected" | "fixed"
  justification    String?
  // What users can do about it (CSAF remediations): vendor_fix | workaround | mitigation | none_available | no_fix_planned
  remediationCategory String?
  remediationDetails  String?
  remediationUrl      String?
  // Updated on every re-scan that still finds this vuln; lets the security
  // team see which findings were not re-confirmed in the latest run.
  lastSeenAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([sbomId])
  @@index([versionId])
  @@index([projectId])
  @@map("project_vulnerabilities")
}

// ─── Vulnerability catalogue, matches and triage ─────────────────────────────
// Matches are global: whether pkg:npm/lodash@4.17.20 is affected by an advisory does not depend on the product.
// The findings of a version are the join of its components, the matches and the catalogue (src/lib/findings.ts).

// Advisory data copied from OSV. Replaces the in-memory cache and the per-finding copies.
model Vulnerability {
  id             String    @id // CVE id, else GHSA id, else the OSV id
  osvId          String // OSV record the details were loaded from
  aliases        String[]
  cveId          String?
  summary        String?
  severity       String? // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "NONE"
  cvssScore      Float?
  cvssVector     String?
  cwes           String[]
  // Versions that fix it, as listed in the advisory
  fixed          String[]
  // EPSS (FIRST): probability of exploitation within 30 days, and its percentile
  epss           Float?
  epssPercentile Float?
  // Listed in the CISA KEV catalogue since; known to be exploited in the wild
  kevAddedAt     DateTime?
  // When the details were loaded; an advisory modified later is loaded again
  fetchedAt      DateTime  @default(now())

  matches  VulnerabilityMatch[]
  analyses Analysis[]

  @@index([osvId])
  @@index([cveId])
  @@map("vulnerabilities")
}

model VulnerabilityMatch {
  componentKey    String
  vulnerabilityId String
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  firstSeenAt     DateTime      @default(now())

  @@id([componentKey, vulnerabilityId])
  @@index([vulnerabilityId])
  @@map("vulnerability_matches")
}

// The decision of a product team about one vulnerability in one component (CycloneDX VEX analysis).
// Per product, not per version: a re-upload and the next release keep it.
model Analysis {
  id                  String        @id @default(cuid())
  projectId           String
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  componentKey        String
  vulnerabilityId     String
  vulnerability       Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  status              String        @default("open") // "open" | "in_triage" | "affected" | "not_affected" | "fixed"
  justification       String?
  // What users can do about it (CSAF remediations): vendor_fix | workaround | mitigation | none_available | no_fix_planned
  remediationCategory String?
  remediationDetails  String?
  remediationUrl      String?
  // Accepted noise: neither counted nor blocking
  suppressed          Boolean       @default(false)
  updatedByName       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  events AnalysisEvent[]

  @@unique([projectId, componentKey, vulnerabilityId])
  @@index([vulnerabilityId])
  @@map("analyses")
}

// History of an analysis: who changed what, with the comment given.
model AnalysisEvent {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  actorName  String
  // field -> [old, new]
  change     Json
  comment    String?

  @@index([analysisId])
  @@map("analysis_events")
}

// Counts of one version on one day, written by the daily scan and by every SBOM upload (src/lib/metrics.ts).
// "Open" numbers count unresolved, unsuppressed findings.
model MetricSnapshot {
  id                   String         @id @default(cuid())
  day                  DateTime       @db.Date
  versionId            String
  version              ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  projectId            String
  critical             Int
  high                 Int
  medium               Int
  low                  Int
  // unresolved findings in total
  findings             Int
  // findings somebody decided on (status other than open)
  audited              Int
  suppressed           Int
  exploited            Int
  policyFail           Int
  policyWarn           Int
  components           Int
  // components without a versioned purl: cannot be checked
  unanalysable         Int
  vulnerableComponents Int
  riskScore            Int

  @@unique([day, versionId])
  @@index([projectId, day])
  @@map("metric_snapshots")
}

// A rule every product has to follow, checked on the components and findings of each version
// (src/lib/policy.ts): a forbidden license, a vulnerability that is too severe, a blocked component.
model Policy {
  id         String   @id @default(cuid())
  name       String
  // What a violation means: "fail" blocks the release gate, "warn" and "info" are shown only
  violation  String   @default("fail") // "fail" | "warn" | "info"
  // "any": one condition is enough, "all": every condition must hold
  operator   String   @default("any") // "any" | "all"
  // [{ subject, value }], see policy.ts
  conditions Json     @default("[]")
  // Products the rule applies to; empty = all
  projectIds String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  waivers PolicyWaiver[]

  @@map("policies")
}

// A product team accepts a violation of a rule for one component, with a reason.
model PolicyWaiver {
  id           String   @id @default(cuid())
  policyId     String
  policy       Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  projectId    String
  componentKey String
  reason       String
  byName       String
  createdAt    DateTime @default(now())

  @@unique([policyId, projectId, componentKey])
  @@map("policy_waivers")
}

// A vulnerability in the manufacturer's own code (for example reported via CVD): not in any SBOM,
// published as a CSAF security advisory.
model OwnVulnerability {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  cveId               String?
  cweId               String?
  cvssVector          String?
  description         String
  // Project version numbers the vulnerability affects
  affectedVersions    Json     @default("[]")
  status              String   @default("affected") // "affected" | "fixed"
  remediationCategory String?
  remediationDetails  String?
  remediationUrl      String?
  acknowledgments     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([projectId])
  @@map("own_vulnerabilities")
}

// Audit trail + overlap lock for the periodic CVE re-scan (triggered by an
// external cron hitting /api/internal/cve-scan).
model CveScanRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String    @default("running") // "running" | "completed" | "failed"
  scannedCount  Int       @default(0)         // unique components queried against OSV
  newCount      Int       @default(0)         // newly created ProjectVulnerability rows
  errorMessage  String?

  @@index([startedAt])
  @@map("cve_scan_runs")
}

// Outgoing webhook for new-finding alerts from the periodic CVE re-scan
// (Slack incoming webhooks, MS Teams connectors, or a generic JSON POST).
// Instance-wide, like the Pro license itself - not scoped to a team.
model AlertChannel {
  id          String   @id @default(cuid())
  url         String
  type        String   @default("generic") // "slack" | "teams" | "generic"
  minSeverity String   @default("HIGH")    // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("alert_channels")
}

// ─── CSAF (Global per Project) ────────────────────────────────────────────────

model CsafAdvisory {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   Json
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("csaf_advisories")
}

model CsafDraft {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title              String   @default("")
  trackingId         String   @default("")
  version            String   @default("1")
  revision           String   @default("Initial release")
  docStatus          String   @default("DRAFT") // DRAFT | REVIEW | PUBLISHED | ARCHIVED
  aggregateSeverity  String   @default("MEDIUM")
  initialReleaseDate DateTime @default(now())
  currentReleaseDate DateTime @default(now())
  tlp                String   @default("CLEAR") // TLP v2: CLEAR | GREEN | AMBER | AMBER+STRICT | RED (mapped to TLP v1 for CSAF 2.0)
  summary            String   @default("")
  details            String   @default("")
  publisherName      String   @default("")
  publisherNamespace String   @default("")
  publisherCategory  String   @default("vendor")
  // "2.0" (OASIS Standard) or "2.1" (Committee Specification Draft, preview)
  csafVersion        String   @default("2.0")
  licenseExpression  String?

  // DEPRECATED: old per-project Art. 14 tracker state, migrated into cra_incidents (kept to avoid a destructive migration)
  craReporting Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("csaf_drafts")
}

// ─── SBOM (Component-Level, legacy - node-scoped within canvas) ──────────────

model SbomComponent {
  id        String   @id @default(cuid())
  diagramId String
  diagram   Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  nodeId    String
  name      String
  version   String?
  purl      String?
  type      String?
  createdAt DateTime @default(now())

  vulnerabilities SbomVulnerability[]

  @@index([diagramId, nodeId])
  @@map("sbom_components")
}

model SbomVulnerability {
  id          String        @id @default(cuid())
  componentId String
  component   SbomComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  osvId       String
  cveId       String?
  summary     String?
  severity    String?       // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  cvssScore   Float?
  source      String        @default("osv.dev")
  createdAt   DateTime      @default(now())

  @@index([componentId])
  @@map("sbom_vulnerabilities")
}

// ─── Feedback ─────────────────────────────────────────────────────────────────

model FeedbackItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "feedback" | "feature" | "bug"
  title     String
  body      String
  votes     Int      @default(0)
  status    String   @default("open") // "open" | "planned" | "done" | "closed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votesList FeedbackVote[]

  @@index([type])
  @@index([votes])
  @@map("feedback_items")
}

model FeedbackVote {
  id        String       @id @default(cuid())
  itemId    String
  item      FeedbackItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([itemId, userId])
  @@index([userId])
  @@map("feedback_votes")
}

// ─── Team Threat Library ──────────────────────────────────────────────────────

model TeamThreatLibraryEntry {
  id                String   @id @default(cuid())
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name              String
  stride            String   // 'S' | 'T' | 'R' | 'I' | 'D' | 'E'
  cweId             String?
  description       String?
  componentTypeHint String?
  createdAt         DateTime @default(now())

  @@index([teamId])
  @@map("team_threat_library_entries")
}

// ─── Measure Evidence ─────────────────────────────────────────────────────────

model MeasureEvidence {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  diagramId   String
  diagram     Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  measureId   String   // client-side UUID from Measure.id in node JSON
  name        String
  storagePath String
  mimeType    String   @default("application/pdf")
  size        Int
  createdAt   DateTime @default(now())

  @@index([diagramId, measureId])
  @@index([projectId])
  @@map("measure_evidence")
}

// Pipeline token scoped to ONE project. Unlike ApiKey (full user access) it only
// reaches the /api/ci/* endpoints, so it is safe to store as a CI secret.
model CiToken {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String    @unique // SHA-256 of the full token (hex)
  prefix      String // first 8 chars after "crci_" for display
  createdById String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  runs CiRun[]

  @@index([projectId])
  @@map("ci_tokens")
}

// One uploaded CI result (SBOM or SARIF scan) for a project version.
model CiRun {
  id          String         @id @default(cuid())
  projectId   String
  versionId   String
  version     ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  tokenId     String?
  token       CiToken?       @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  source      String // "sbom" | "sast" | "secrets" | "vulnscan"
  part        String         @default("")
  result      String // "ok" | "findings"
  summary     String
  metrics     Json
  commit      String?
  ref         String?
  url         String?
  fileName    String
  storagePath String
  size        Int
  sha256      String
  createdAt   DateTime       @default(now())

  @@index([versionId, source, part, createdAt])
  @@index([projectId])
  @@map("ci_runs")
}

// Organisation-scoped answers of the CRA readiness self-assessment (one row, applies to every product).
model OrgReadiness {
  id            String   @id @default("org")
  answers       Json     @default("{}")
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@map("org_readiness")
}

// The manufacturer: one row per installation. Publisher profile, vulnerability contact (security.txt,
// CVD policy), the vulnerability-handling requirements that hold for every product, and the SDL checklist.
// Products inherit these and may override a requirement (Project.craChecklist wins).
model Organisation {
  id                String   @id @default("org")
  name              String   @default("")
  publisherName     String?
  publisherNamespace String?
  publisherCategory String   @default("vendor") // vendor | coordinator | discoverer | other
  issuingAuthority  String?
  contactDetails    String?
  securityTxt       Json     @default("{}")
  craChecklist      Json     @default("{}")
  sdlChecklist      Json     @default("{}")
  updatedByName     String?
  updatedAt         DateTime @updatedAt

  @@map("organisation")
}

// Review of ONE frozen version by an assessor (member of a review team, or admin).
// The product team's checklist is copied at the start so the review stays stable when the checklist changes later.
model Assessment {
  id                String         @id @default(cuid())
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId         String         @unique
  version           ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  assessorId        String
  assessorName      String
  status            String         @default("open") // "open" | "approved" | "rejected"
  summary           String?
  decidedAt         DateTime?
  checklistSnapshot Json           @default("{}")
  createdAt         DateTime       @default(now())

  items AssessmentItem[]

  @@index([projectId])
  @@map("assessments")
}

model AssessmentItem {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  requirementId String
  verdict       String     // "accepted" | "finding" | "not_applicable"
  comment       String?
  dueDate       DateTime?
  response      String?    // answer of the product team to a finding
  resolved      Boolean    @default(false)
  updatedAt     DateTime   @updatedAt

  @@unique([assessmentId, requirementId])
  @@map("assessment_items")
}

// One Art. 14 reporting case: an actively exploited vulnerability or a severe incident.
// Deadlines run from awareAt (24 h early warning, 72 h notification); the final report is due
// 14 days after a corrective measure is available (vulnerability) or one month after the
// incident notification (incident). Submission itself happens on the ENISA single reporting platform.
model CraIncident {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind               String    // "vulnerability" | "incident"
  title              String
  cveId              String?
  source             String    @default("manual") // "manual" | "kev"
  awareAt            DateTime
  memberStates       String    @default("")
  measureAvailableAt DateTime? // vulnerability: corrective or mitigating measure available
  earlyWarningAt     DateTime? // submitted at
  notificationAt     DateTime?
  finalReportAt      DateTime?
  closedAt           DateTime?
  notes              String?
  // reminder dedupe: which deadline reminders were already sent ("early", "notification", "final")
  remindersSent      Json      @default("{}")
  createdAt          DateTime  @default(now())

  @@index([projectId])
  @@map("cra_incidents")
}
